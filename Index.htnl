<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Astitva Bhatt | Senior Digital Marketing Professional</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #003d82;
            --secondary: #0055cc;
            --accent: #0077ff;
            --dark-bg: #0d1117;
            --dark-card: #161b22;
            --dark-border: #21262d;
            --text-primary: #ffffff;
            --text-secondary: #8b949e;
            --success: #238636;
            --gradient-1: linear-gradient(135deg, #003d82 0%, #0055cc 100%);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #0d1117;
            color: var(--text-primary);
            line-height: 1.6;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-40px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Header/Navigation */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(13, 17, 23, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--dark-border);
            z-index: 1000;
            padding: 1.2rem 0;
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-logo {
            font-size: 1.4rem;
            font-weight: 900;
            letter-spacing: -0.5px;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        nav {
            display: flex;
            gap: 3rem;
        }

        nav a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s;
            position: relative;
        }

        nav a:hover {
            color: var(--accent);
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent);
            transition: width 0.3s;
        }

        nav a:hover::after {
            width: 100%;
        }

        /* Main Container */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 50px;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 120px;
            position: relative;
        }

        .hero::before {
            content: '';
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(0, 85, 204, 0.08) 0%, transparent 70%);
            top: -200px;
            left: -200px;
        }

        .hero::after {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(0, 119, 255, 0.08) 0%, transparent 70%);
            bottom: -100px;
            right: -100px;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 1000px;
            animation: fadeInUp 1s ease-out;
        }

        .hero h1 {
            font-size: 5.5rem;
            font-weight: 900;
            letter-spacing: -2px;
            line-height: 1.1;
            margin-bottom: 1rem;
        }

        .hero h1 .accent {
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-subtitle {
            font-size: 1.6rem;
            color: var(--text-secondary);
            font-weight: 500;
            margin-bottom: 2rem;
            letter-spacing: 0.3px;
        }

        .hero-description {
            font-size: 1.1rem;
            color: var(--text-secondary);
            line-height: 1.8;
            margin-bottom: 3rem;
            max-width: 750px;
        }

        .cta-buttons {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 40px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
            display: inline-block;
        }

        .btn-primary {
            background: var(--gradient-1);
            color: white;
            box-shadow: 0 10px 30px rgba(0, 85, 204, 0.25);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0, 85, 204, 0.35);
        }

        .btn-secondary {
            background: transparent;
            color: var(--accent);
            border: 2px solid var(--accent);
        }

        .btn-secondary:hover {
            background: rgba(0, 119, 255, 0.1);
            transform: translateY(-3px);
        }

        /* Key Metrics */
        .metrics-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 4rem;
        }

        .metric {
            background: rgba(22, 27, 34, 0.6);
            border: 1px solid var(--dark-border);
            padding: 2rem;
            border-radius: 10px;
            text-align: center;
        }

        .metric-value {
            font-size: 2.5rem;
            font-weight: 900;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .metric-label {
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.95rem;
        }

        /* Sections */
        section {
            padding: 100px 0;
            position: relative;
        }

        .section-title {
            font-size: 3.5rem;
            font-weight: 900;
            letter-spacing: -1px;
            margin-bottom: 1.5rem;
        }

        .section-subtitle {
            font-size: 1.1rem;
            color: var(--text-secondary);
            max-width: 700px;
            margin-bottom: 3rem;
            line-height: 1.7;
        }

        /* Executive Summary */
        .executive-summary {
            background: linear-gradient(135deg, rgba(0, 85, 204, 0.08) 0%, rgba(0, 119, 255, 0.08) 100%);
            border: 1px solid var(--dark-border);
            padding: 4rem;
            border-radius: 12px;
            margin-bottom: 3rem;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }

        .summary-text h3 {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            color: var(--accent);
        }

        .summary-text p {
            color: var(--text-secondary);
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }

        .summary-bullets {
            list-style: none;
        }

        .summary-bullets li {
            padding: 0.8rem 0;
            color: var(--text-secondary);
            position: relative;
            padding-left: 2rem;
        }

        .summary-bullets li::before {
            content: "▸";
            position: absolute;
            left: 0;
            color: var(--accent);
            font-weight: bold;
            font-size: 1.2rem;
        }

        .summary-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .summary-stat {
            background: rgba(22, 27, 34, 0.8);
            border: 1px solid var(--dark-border);
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
        }

        .summary-stat .value {
            font-size: 2rem;
            font-weight: 900;
            color: var(--accent);
            margin-bottom: 0.5rem;
        }

        .summary-stat .label {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* Expertise Section */
        .expertise-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
            margin-bottom: 3rem;
        }

        .expertise-card {
            background: rgba(22, 27, 34, 0.6);
            border: 1px solid var(--dark-border);
            padding: 3rem 2.5rem;
            border-radius: 12px;
            transition: all 0.3s;
            animation: fadeInUp 0.8s ease-out backwards;
        }

        .expertise-card:nth-child(1) { animation-delay: 0.1s; }
        .expertise-card:nth-child(2) { animation-delay: 0.2s; }
        .expertise-card:nth-child(3) { animation-delay: 0.3s; }

        .expertise-card:hover {
            border-color: var(--accent);
            background: rgba(22, 27, 34, 0.9);
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0, 85, 204, 0.15);
        }

        .expertise-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .expertise-card h3 {
            font-size: 1.4rem;
            margin-bottom: 1.5rem;
            color: var(--accent);
            font-weight: 800;
        }

        .expertise-card ul {
            list-style: none;
        }

        .expertise-card li {
            padding: 0.7rem 0;
            color: var(--text-secondary);
            font-weight: 500;
            position: relative;
            padding-left: 1.8rem;
        }

        .expertise-card li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--success);
            font-weight: bold;
        }

        /* Experience Timeline */
        .experience-item {
            background: rgba(22, 27, 34, 0.6);
            border: 1px solid var(--dark-border);
            padding: 3rem;
            margin-bottom: 2rem;
            border-radius: 12px;
            transition: all 0.3s;
            animation: fadeInUp 0.8s ease-out backwards;
        }

        .experience-item:nth-child(1) { animation-delay: 0.1s; }
        .experience-item:nth-child(2) { animation-delay: 0.2s; }
        .experience-item:nth-child(3) { animation-delay: 0.3s; }

        .experience-item:hover {
            border-color: var(--accent);
            background: rgba(22, 27, 34, 0.9);
            transform: translateX(10px);
            box-shadow: 0 20px 50px rgba(0, 85, 204, 0.15);
        }

        .experience-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .experience-item h3 {
            font-size: 1.6rem;
            color: var(--accent);
            font-weight: 800;
        }

        .experience-badge {
            background: rgba(0, 119, 255, 0.1);
            border: 1px solid var(--accent);
            color: var(--accent);
            padding: 0.5rem 1.2rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .experience-company {
            color: var(--text-secondary);
            font-weight: 600;
            margin-bottom: 1.5rem;
            font-size: 1rem;
        }

        .experience-item ul {
            list-style: none;
            margin-top: 1.5rem;
        }

        .experience-item li {
            padding: 0.8rem 0 0.8rem 2rem;
            color: var(--text-secondary);
            position: relative;
            line-height: 1.7;
        }

        .experience-item li::before {
            content: "→";
            position: absolute;
            left: 0;
            color: var(--success);
            font-weight: bold;
            font-size: 1.1rem;
        }

        /* Case Studies */
        .case-study-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5rem;
        }

        .case-study {
            background: rgba(22, 27, 34, 0.6);
            border: 1px solid var(--dark-border);
            padding: 3rem;
            border-radius: 12px;
            transition: all 0.3s;
            animation: fadeInUp 0.8s ease-out backwards;
        }

        .case-study:nth-child(1) { animation-delay: 0.1s; }
        .case-study:nth-child(2) { animation-delay: 0.2s; }

        .case-study:hover {
            border-color: var(--accent);
            background: rgba(22, 27, 34, 0.9);
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0, 85, 204, 0.15);
        }

        .case-study h3 {
            font-size: 1.4rem;
            color: var(--accent);
            margin-bottom: 0.8rem;
            font-weight: 800;
        }

        .case-study .period {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        .case-study p {
            color: var(--text-secondary);
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        .kpi-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .kpi-tag {
            background: rgba(35, 134, 54, 0.1);
            border: 1px solid var(--success);
            color: var(--success);
            padding: 0.6rem 1.2rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        /* Education */
        .edu-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
        }

        .edu-card {
            background: rgba(22, 27, 34, 0.6);
            border: 1px solid var(--dark-border);
            padding: 3rem;
            border-radius: 12px;
            transition: all 0.3s;
            animation: fadeInUp 0.8s ease-out backwards;
        }

        .edu-card:nth-child(1) { animation-delay: 0.1s; }
        .edu-card:nth-child(2) { animation-delay: 0.2s; }

        .edu-card:hover {
            border-color: var(--accent);
            background: rgba(22, 27, 34, 0.9);
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0, 85, 204, 0.15);
        }

        .edu-card h3 {
            font-size: 1.4rem;
            color: var(--accent);
            margin-bottom: 1rem;
            font-weight: 800;
        }

        .edu-card p {
            color: var(--text-secondary);
            line-height: 1.7;
            margin-bottom: 0.8rem;
        }

        .status-badge {
            display: inline-block;
            background: rgba(35, 134, 54, 0.1);
            border: 1px solid var(--success);
            color: var(--success);
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            margin-top: 1rem;
        }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, rgba(0, 85, 204, 0.1) 0%, rgba(0, 119, 255, 0.1) 100%);
            border: 1px solid var(--dark-border);
            border-radius: 15px;
            padding: 6rem 4rem;
            text-align: center;
            margin: 5rem 0;
        }

        .cta-section h2 {
            font-size: 2.8rem;
            margin-bottom: 1.5rem;
            font-weight: 900;
        }

        .cta-section p {
            font-size: 1.15rem;
            color: var(--text-secondary);
            margin-bottom: 2.5rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.8;
        }

        .cta-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Footer */
        footer {
            background: rgba(13, 17, 23, 0.95);
            border-top: 1px solid var(--dark-border);
            padding: 4rem 0;
            text-align: center;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 2.5rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
        }

        .footer-links a:hover {
            color: var(--accent);
            transform: translateY(-3px);
        }

        footer p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-bottom: 0.8rem;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .container {
                padding: 0 30px;
            }

            .header-content {
                padding: 0 30px;
            }

            .expertise-grid, .case-study-grid, .edu-grid {
                grid-template-columns: 1fr;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 4rem;
            }

            .section-title {
                font-size: 2.5rem;
            }
        }

        @media (max-width: 768px) {
            .header-content {
                padding: 0 20px;
            }

            nav {
                gap: 1.5rem;
                font-size: 0.85rem;
            }

            .container {
                padding: 0 20px;
            }

            .hero {
                padding-top: 80px;
            }

            .hero h1 {
                font-size: 2.5rem;
            }

            .hero-subtitle {
                font-size: 1.2rem;
            }

            .section-title {
                font-size: 2rem;
            }

            .metrics-row {
                grid-template-columns: 1fr;
            }

            .cta-section {
                padding: 3rem 2rem;
            }

            section {
                padding: 60px 0;
            }

            .cta-buttons {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                text-align: center;
            }
        }

        @media (max-width: 600px) {
            header {
                padding: 1rem 0;
            }

            nav {
                display: none;
            }

            .hero h1 {
                font-size: 2rem;
            }

            .hero-subtitle {
                font-size: 1rem;
            }

            .hero-description {
                font-size: 0.95rem;
            }

            .section-title {
                font-size: 1.6rem;
       
